# =============================================================================
# Shikkhabhumi API — Docker / VPS environment
# Copy: cp .env.docker.example .env
# =============================================================================

# --- Server ---
PORT=3000
NODE_ENV=production
BASE_URL=https://api.shikkhabhumi.com
FRONTEND_URL=https://shikkhabhumi.com

# Extra allowed browser origins (comma-separated). Vercel preview example:
# CORS_EXTRA_ORIGINS=https://shikkhabhumi.vercel.app,https://your-project.vercel.app
# Institute subdomains (https://*.shikkhabhumi.com) are allowed by default in cors.js.
CORS_EXTRA_ORIGINS=

RUN_WORKER=0

# Docker nginx host port
HTTP_PORT=8080

# --- PostgreSQL (Supabase pooler example) ---
DB_HOST=aws-1-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=true
DB_POOL_MAX=30
DB_POOL_MIN=2

# --- Auth ---
JWT_SECRET=change_me_long_random_string

# --- Video encryption keys (persisted in Docker volume app_keys) ---
KEYS_ROOT_DIR=./keys

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=videos

# R2 custom domain (Cloudflare dashboard → R2 bucket → Connect Custom Domain)
# Example production domain:
R2_PUBLIC_URL=https://media.shikkhabhumi.com
R2_CDN_PUBLIC_URL=https://media.shikkhabhumi.com

# HLS segment delivery (see backend/docs/R2-COST-OPTIMIZATION.md)
#   cdn     = production — media.shikkhabhumi.com + Cloudflare edge cache (recommended)
#   presign = short-lived signed R2 URLs for .ts (rollback / staging)
#   off     = API proxy only (emergency rollback)
CDN_SEGMENT_DELIVERY=cdn
HLS_SEGMENT_PRESIGN_TTL=120
HLS_LADDER_ENABLED=true
HLS_SEGMENT_SECONDS=2

# --- Video worker R2 performance (worker container / npm run worker) ---
# Parallel uploads during HLS "storing" stage. Safe default: 12. Raise on larger VPS (max 32).
R2_UPLOAD_CONCURRENCY=12
# Parallel server-side copy during HLS promote.
R2_COPY_CONCURRENCY=12
# Multipart stream upload tuning for large files (original source, etc.).
R2_UPLOAD_QUEUE_SIZE=4
R2_UPLOAD_PART_SIZE_MB=10

# --- Live streaming (Agora / 100ms / etc.) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
HM_APP_ACCESS_KEY=
HM_APP_SECRET=
HM_TEMPLATE_ID=

# --- R2 Live HLS (MediaMTX bundled in docker-compose — no separate install) ---
# vps-deploy.sh auto-sets MEDIAMTX_WHIP_PUBLIC_URL + MEDIAMTX_WEBRTC_HOST from BASE_URL above.
# Enable in Admin → Settings → Live → "R2 Live (HLS)".
# LIVE_FORCE_PROVIDER=r2_live   # optional: force r2_live for all new classes (testing)

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Redis (set automatically in docker-compose; override if external) ---
REDIS_URL=redis://redis:6379

# --- Rate limiting & write batching ---
RATE_LIMIT_ENABLED=true
ANALYTICS_BATCH_MS=30000
PROGRESS_BATCH_MS=15000
LIVE_HEARTBEAT_BATCH_MS=15000

# --- Optional ---
# SERVER_TIMEOUT_MS=18000000   # large multipart upload finalize (5h)
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_ANALYTICS_MAX=120

# --- Multi-device login limit & abuse detection ---
# MAX_CONCURRENT_DEVICES=2
# DEVICE_ABUSE_WINDOW_DAYS=7
# DEVICE_ABUSE_DISTINCT_THRESHOLD=4
# PENDING_SESSION_TOKEN_TTL_SECONDS=300
